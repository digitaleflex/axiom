# Axiom Cloud Console — environment configuration
#
# Base URL of the Axiom Engine HTTP API (no trailing slash, no /api/v1 suffix).
# The client appends the versioned prefix `/api/v1` itself (api-contract §1).
#
# Default when unset: http://localhost:8080
VITE_AXIOM_API_URL=http://localhost:8080

# NOTE: authentication is INTERIM. There is no OAuth/OIDC provider yet (#125).
# The console stores a single bearer token (AXIOM_API_TOKEN on the Engine) in
# sessionStorage under the key `axiom.token`. Do NOT put the token itself in a
# .env file or in source control — it is entered at runtime on /login.
